# AVIF & WebP support — place near top of file
AddType image/avif  .avif
AddType image/webp  .webp



############################################################
# 1) FORCE HTTPS & CANONICAL HOST
############################################################
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never expose dot-directories such as a deployment checkout's .git data.
  # Keep ACME's standardized .well-known path available for certificate renewal.
  RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]

  # Redirect directly to the configured canonical origin. Avoid reflecting an
  # untrusted Host header into the Location response.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^robarch2024\.org$ [NC]
  RewriteRule ^ https://robarch2024.org%{REQUEST_URI} [L,R=301,NE]
</IfModule>


############################################################
# 2) COMPRESSION (mod_deflate)
############################################################
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml application/xhtml+xml application/rss+xml application/atom+xml font/ttf font/otf font/woff font/woff2

  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif)$ no-gzip
</IfModule>


############################################################
# 3) MIME-TYPE EXPIRES HEADERS (mod_expires + mod_headers)
############################################################
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  ExpiresByType text/html           "access plus 1 hour"
  ExpiresByType text/css            "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/plain          "access plus 1 month"

  ExpiresByType image/svg+xml       "access plus 1 month"
  ExpiresByType image/webp          "access plus 1 month"
  ExpiresByType image/avif          "access plus 1 month"
  ExpiresByType image/jpeg          "access plus 1 month"
  ExpiresByType image/png           "access plus 1 month"
  ExpiresByType image/gif           "access plus 1 month"

  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType font/woff           "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-ttf  "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|gif|avif|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>


############################################################
# 4) SECURITY HEADERS
############################################################
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; media-src 'self'; frame-src https://player.vimeo.com; connect-src 'self' https://analytics.google.com https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; upgrade-insecure-requests"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always unset X-Powered-By
</IfModule>


############################################################
# 5) ETAGS & SERVER SIGNATURE
############################################################
FileETag None
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
ServerSignature Off


############################################################
# 6) CUSTOM ERRORS & REDIRECTS
############################################################
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# Add any site‑specific redirects below, e.g.:
# Redirect 301 /old-path/ /new-path/

Redirect 301 /branch-production/ /workshop/branch-production/
Redirect 301 /choreographing-cable-robots/ /workshop/choreographing-cable-robots/
Redirect 301 /collaboration-between-design-and-automated-fabrication/ /workshop/collaboration-between-design-and-automated-fabrication/
Redirect 301 /collaborative-augmented-assembly/ /workshop/collaborative-augmented-assembly/
Redirect 301 /dropship-joyride/ /workshop/dropship-joyride/
Redirect 301 /exploring-centralization-in-collective-robotic-construction/ /workshop/exploring-centralization-in-collective-robotic-construction/
Redirect 301 /robots-in-the-landscape/ /workshop/robots-in-the-landscape/
Redirect 301 /sculpting-space-with-on-site-robotics/ /workshop/sculpting-space-with-on-site-robotics/
